<Project>

  <ItemGroup Condition="'$(IJzerRepositoryBootstrapEnabled)' == 'true' and '$(EnableArchitecturalLevelAnalyzer)' == 'true'">
    <Analyzer Include="$(NuGetPackageRoot)$([System.String]::Copy('$(IJzerBootstrapPackageId)').ToLowerInvariant())\$(IJzerBootstrapVersion)\analyzers\dotnet\cs\*.dll" />
  </ItemGroup>

</Project>
