<ArchitecturalLevels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xsi:noNamespaceSchemaLocation="../../../../src/Main/RonSijm.AnaalIJzer/Scheme/AnaalIJzer.xsd"
                     description="Only the factory creates a DbContext; repositories receive it after creation.">
  <Layer name="Application" description="Application services use repositories and do not create contexts.">
    <Class endsWith="Service" />
  </Layer>
  <Layer name="Repository" description="Repositories receive a context through DI.">
    <Class endsWith="Repository" />
  </Layer>
  <Layer name="ContextFactory" description="The context factory is the only owner that creates a DbContext.">
    <Class endsWith="DbContextFactory" />
  </Layer>
  <Layer name="Context" description="DbContext represents the EF Core unit of work.">
    <Class inherits="DbContext" />
  </Layer>

  <AllowedDependency from="Application" to="Repository" />
  <AllowedDependency from="Repository" to="Context" allowedSites="Constructor" />
  <AllowedDependency from="ContextFactory" to="Context" allowedSites="New, MethodReturn" description="The factory may create and return the context it owns." />
</ArchitecturalLevels>
