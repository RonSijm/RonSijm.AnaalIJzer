  <NamespaceHierarchyPolicy rootNamespace="Restaurant.NamespaceHierarchySites.AllowedStaticMember"><BlockedRelation relation="DescendantToAncestor" allowedSites="StaticMember" /></NamespaceHierarchyPolicy>
