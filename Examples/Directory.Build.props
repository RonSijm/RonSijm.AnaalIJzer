<Project>

  <Import Project="..\build\Settings\RonSijm.AnaalIJzer.props"
          Condition="Exists('..\build\Settings\RonSijm.AnaalIJzer.props')" />

  <!--
    Shared MSBuild props for every example project under Examples/.

    The example projects intentionally trigger ARCH00X errors as living
    documentation. The examples should therefore light up in ordinary IDE and
    Debug builds by default.

      Debug   - analyzer ON
      Release - analyzer ON

    Easy toggle: flip EnableAnalyzerOnDebug below to false if you want the
    examples to stay quiet during normal IDE / Debug editing.

    Per-build or per-project overrides still work:
      <EnableArchitecturalLevelAnalyzer>true</EnableArchitecturalLevelAnalyzer>
    or:  dotnet build Examples\Documentation\Example.ReportDemo -p:EnableArchitecturalLevelAnalyzer=true
  -->

  <PropertyGroup>
    <!-- Flip to false to keep Debug builds quiet while editing the examples in the IDE. -->
    <EnableAnalyzerOnDebug Condition="'$(EnableAnalyzerOnDebug)' == ''">true</EnableAnalyzerOnDebug>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <!-- Suppress "parameter unread" - example classes are intentionally minimal stubs -->
    <NoWarn>CS9113</NoWarn>
    <AnaalIJzerEngineProjectPath>$(MSBuildThisFileDirectory)..\src\Main\RonSijm.AnaalIJzer.Engine\RonSijm.AnaalIJzer.Engine.csproj</AnaalIJzerEngineProjectPath>
    <AnaalIJzerEngineOutputDirectory>$(MSBuildThisFileDirectory)..\src\Main\RonSijm.AnaalIJzer.Engine\bin\$(Configuration)\netstandard2.0\</AnaalIJzerEngineOutputDirectory>
    <EnableArchitecturalLevelAnalyzer Condition="'$(EnableArchitecturalLevelAnalyzer)' == '' AND '$(Configuration)' == 'Release'">true</EnableArchitecturalLevelAnalyzer>
    <EnableArchitecturalLevelAnalyzer Condition="'$(EnableArchitecturalLevelAnalyzer)' == '' AND '$(EnableAnalyzerOnDebug)' == 'true'">true</EnableArchitecturalLevelAnalyzer>
    <EnableArchitecturalLevelAnalyzer Condition="'$(EnableArchitecturalLevelAnalyzer)' == ''">false</EnableArchitecturalLevelAnalyzer>
  </PropertyGroup>

  <Target Name="AttachAnaalIJzerExampleAnalyzers"
          BeforeTargets="CoreCompile"
          Condition="'$(EnableArchitecturalLevelAnalyzer)' == 'true'">
    <MSBuild Projects="$(AnaalIJzerEngineProjectPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />

    <ItemGroup>
      <Analyzer Include="$(AnaalIJzerEngineOutputDirectory)RonSijm.AnaalIJzer*.dll" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\*.anl" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\..\*.anl" />
  </ItemGroup>

  <Import Project="..\build\Settings\RonSijm.AnaalIJzer.targets"
          Condition="Exists('..\build\Settings\RonSijm.AnaalIJzer.targets')" />

</Project>
