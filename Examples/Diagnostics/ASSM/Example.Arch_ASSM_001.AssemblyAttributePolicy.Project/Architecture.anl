<ArchitecturalLevels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xsi:noNamespaceSchemaLocation="../../../../src/Main/RonSijm.AnaalIJzer/Scheme/AnaalIJzer.xsd"
                     description="Only approved kitchen teams may receive the restaurant's internal recipe notes.">
  <AssemblyAttributePolicy description="Friend assembly access is intentional and reviewed.">
    <Forbidden>
      <Attribute exactFullName="System.Runtime.CompilerServices.InternalsVisibleToAttribute"
                 description="The unapproved kitchen must not receive internal recipe access.">
        <Argument index="0" exactName="NotAllowedExample" />
      </Attribute>
    </Forbidden>
  </AssemblyAttributePolicy>
</ArchitecturalLevels>
