<ArchitecturalLevels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xsi:noNamespaceSchemaLocation="../../../src/Main/RonSijm.AnaalIJzer/Scheme/AnaalIJzer.xsd"
                     description="A named restaurant operation has one kitchen owner and selected waiter entry points.">
  <Layer name="Controller" description="Waiters receive an order and pass it to the kitchen.">
    <Class endsWith="Controller" />
  </Layer>
  <Layer name="Application" description="The kitchen owns the actual order operation.">
    <Class endsWith="Kitchen" />
  </Layer>
  <AllowedDependency from="Controller" to="Application" />

  <Operations description="These names are explicit application contracts, not inferred routes or conventions.">
    <Operation name="PlacePizzaOrder"
               allowedOwnerLayers="Application"
               allowedEntryPointLayers="Controller"
               description="A waiter submits one pizza order to the kitchen and receives the confirmed order.">
      <Owner description="The kitchen owns the operation.">
        <DeclarationMatcher>
          <ContainingType endsWith="Kitchen" />
          <Member exactName="PlacePizzaOrder" memberKind="Method" />
        </DeclarationMatcher>
      </Owner>
      <Request><Class exactName="PlacePizzaOrderRequest" /></Request>
      <Response><Class exactName="PlacePizzaOrderResponse" /></Response>
      <EntryPoint description="Only selected waiter methods are required to call the owner directly.">
        <DeclarationMatcher>
          <ContainingType endsWith="Controller" />
          <Member exactName="PlacePizzaOrder" memberKind="Method" />
        </DeclarationMatcher>
      </EntryPoint>
    </Operation>
  </Operations>
</ArchitecturalLevels>
