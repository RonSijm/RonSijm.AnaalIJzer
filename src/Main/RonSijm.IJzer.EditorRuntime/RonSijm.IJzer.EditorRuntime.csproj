        <ProjectReference Include="..\RonSijm.IJzer.Core.SemanticOperations\RonSijm.IJzer.Core.SemanticOperations.csproj" />
        <ProjectReference Include="..\RonSijm.IJzer.Core.Findings\RonSijm.IJzer.Core.Findings.csproj" />
        <ProjectReference Include="..\RonSijm.IJzer.Core.Configuration.Compilation\RonSijm.IJzer.Core.Configuration.Compilation.csproj" />
        <ProjectReference Include="..\RonSijm.IJzer.Engine\RonSijm.IJzer.Engine.csproj" />
        <ProjectReference Include="..\RonSijm.IJzer.GraphModel\RonSijm.IJzer.GraphModel.csproj"
                          SetTargetFramework="TargetFramework=netstandard2.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    </ItemGroup>

</Project>
