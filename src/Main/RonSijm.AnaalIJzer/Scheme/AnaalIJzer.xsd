<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="ArchitecturalLevels">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded" minOccurs="0">
        <xs:element name="Include"           type="IncludeType" />
        <xs:element name="ExceptionPolicy"   type="ExceptionPolicyType" />
        <xs:element name="Layer"             type="LayerType" />
        <xs:element name="Allowed"           type="AllowedContainerType" />
        <xs:element name="Forbidden"         type="ForbiddenContainerType" />
        <xs:element name="AllowedDependency" type="AllowedDependencyType" />
        <xs:element name="BlockedDependency" type="BlockedDependencyType" />
        <xs:element name="ProjectArchitecture" type="ProjectArchitectureType" />
      </xs:choice>
      <xs:attributeGroup ref="DocumentationAttributes" />
      <xs:attribute name="requireRecognizedDependencies" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            Comma-separated dependency sites where referenced types must be assigned to a layer.
            Unrecognized dependencies raise ARCH002. Supported values: Constructor, Method,
            MethodReturn, Field, Property, Local, New, GenericInvocation, GenericArgument,
            Inheritance, InterfaceImplementation, Attribute, StaticMember. When omitted,
            unknown types do not raise ARCH002.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="enforceAcyclic" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>
            When true, explicit AllowedDependency edges must form an acyclic graph.
            Wildcard and self edges are excluded from cycle detection.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="enforceObservedAcyclic" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>
            When true, currently observed source dependencies must not form a cycle between
            configured layers. Unlike enforceAcyclic, this checks code reality rather than
            configured AllowedDependency edges.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="enableReport" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>
            When true, Arse uses reportPath as the default output for the Markdown
            violation report.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="reportPath" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            Path for the generated Markdown report. Relative paths are resolved from the
            directory of this file, or from the project file for inline config. Default:
            architectural-violations.md.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="enableDocumentation" type="xs:boolean" default="false">
        <xs:annotation>
          <xs:documentation>
            When true, Arse uses documentationPath as the default output for a Markdown
            document containing Mermaid diagrams and the configured rule descriptions.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="documentationPath" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            Path for the generated architecture documentation (Markdown file). Relative paths
            are resolved from the directory of this file, or from the project file for inline
            config. Default: architecture-documentation.md.
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:attributeGroup name="DocumentationAttributes">
    <xs:attribute name="description" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Optional human-readable description used by generated architecture documentation.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:complexType name="IncludeType">
    <xs:annotation>
      <xs:documentation>
        Includes another ArchitecturalLevels XML file. The path is resolved relative to the
        file that declares the Include. Included files can include other files; files already
        seen during the current parse are skipped to avoid cycles.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="path" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Relative or absolute path to another ArchitecturalLevels XML file.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ExceptionPolicyType">
    <xs:annotation>
      <xs:documentation>
        Configures optional metadata requirements and review thresholds for exceptions declared
        inside any Exceptions container. When omitted, exceptions keep their existing behavior
        and no review warnings are produced.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="requireReason" type="xs:boolean" default="false" />
    <xs:attribute name="requireOwner" type="xs:boolean" default="false" />
    <xs:attribute name="requireExpiresOn" type="xs:boolean" default="false" />
    <xs:attribute name="warnBeforeDays" type="xs:nonNegativeInteger" default="14" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!--  <Layer name="Application">                                        -->
  <!--      <Class endsWith="Manager" />                                  -->
  <!--      <Namespace contains="Application" />                         -->
  <!--  </Layer>                                                          -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->

  <xs:complexType name="LayerType">
    <xs:annotation>
      <xs:documentation>
        Declares a named architectural layer or boundary. Child Class, Namespace, and Assembly
        elements describe its scope. Nested Layer elements refine that scope. Dependency rules
        declared inside the layer govern the boundary gates beneath that scope.
        requireRecognizedDependencies can be set on a layer to require recognized dependencies
        only for callers classified into that layer or its descendants.

        To make this layer a crosscutting concern (usable from any other layer), add:
          &lt;AllowedDependency from="*" to="LayerName" /&gt;
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Class"     type="ClassMatchType" />
      <xs:element name="Namespace" type="NamespaceMatchType" />
      <xs:element name="Assembly"  type="AssemblyMatchType" />
      <xs:element name="Layer"     type="LayerType" />
      <xs:element name="Allowed"   type="AllowedContainerType" />
      <xs:element name="Forbidden" type="ForbiddenContainerType" />
      <xs:element name="NameRules" type="NameRulesType" />
      <xs:element name="InheritancePolicy" type="InheritancePolicyType" />
      <xs:element name="VisibilityPolicy" type="VisibilityPolicyType" />
      <xs:element name="ContractPolicy" type="ContractPolicyType" />
      <xs:element name="ApiSurface" type="ApiSurfaceType" />
      <xs:element name="EntryPoints" type="EntryPointsType" />
      <xs:element name="SourceLocations" type="SourceLocationsType" />
      <xs:element name="AllowedDependency" type="AllowedDependencyType" />
      <xs:element name="BlockedDependency" type="BlockedDependencyType" />
    </xs:choice>
    <xs:attribute name="name" type="LayerNameType" use="required">
      <xs:annotation>
        <xs:documentation>
          The layer name. Referenced in AllowedDependency edges and diagnostic messages.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="requireRecognizedDependencies" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Comma-separated dependency sites where callers in this layer or its descendants must
          use dependencies assigned to a layer. Supported values: Constructor, Method,
          MethodReturn, Field, Property, Local, New, GenericInvocation, GenericArgument,
          Inheritance, InterfaceImplementation, Attribute, StaticMember. The layer list is
          cumulative with root and ancestor layer lists.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!--  <Allowed>                                                         -->
  <!--      <Class startsWith="Create" />                                 -->
  <!--      <Class startsWith="Cancel" />                                 -->
  <!--  </Allowed>                                                        -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->

  <xs:complexType name="AllowedContainerType">
    <xs:annotation>
      <xs:documentation>
        Groups the type patterns that are permitted by an allow-list. A classified dependency
        must match at least one rule in every applicable Allowed container. At the root the
        policy applies globally; inside a Layer it applies to that layer and all descendants.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="Class"     type="ClassMatchType" />
      <xs:element name="Namespace" type="NamespaceMatchType" />
    </xs:choice>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="VisibilityPolicyType">
    <xs:annotation>
      <xs:documentation>
        Restricts the declared accessibility of source declarations owned by this layer or a
        descendant. targets is a comma-separated list containing Type, Constructor, Method,
        Property, Field, Event, Operator, Conversion, or NestedType. Configure exactly one of
        allowedAccessibilities and blockedAccessibilities with values from Public, Internal,
        Protected, ProtectedInternal, PrivateProtected, Private, and File.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="targets" type="xs:string" use="required" />
    <xs:attribute name="allowedAccessibilities" type="xs:string" />
    <xs:attribute name="blockedAccessibilities" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="InheritancePolicyType">
    <xs:annotation>
      <xs:documentation>
        Requires declarations owned by this layer or a descendant to carry an explicit base
        type and/or interface contract. typeKinds is required and uses the same declared-type
        tokens as Class typeKind: Class, Interface, Struct, Record, RecordStruct, Enum, or
        Delegate. Configure at least one of requiredBaseTypes or requiredInterfaces as a
        comma-separated list of simple or fully qualified type names.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="typeKinds" type="xs:string" use="required" />
    <xs:attribute name="requiredBaseTypes" type="xs:string" />
    <xs:attribute name="requiredInterfaces" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ApiSurfaceType">
    <xs:annotation>
      <xs:documentation>
        Restricts which configured layers may appear in externally visible declarations owned
        by this layer or a descendant. BlockedLayer wins over AllowedLayer. When one or more
        AllowedLayer entries apply to a declaration site, the exposed type must match one of
        them. requireRecognizedTypes also rejects exposed types that match no configured layer.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="AllowedLayer" type="ApiSurfaceLayerRuleType" />
      <xs:element name="BlockedLayer" type="ApiSurfaceLayerRuleType" />
      <xs:element name="TransitiveExposure" type="TransitiveExposureType" />
    </xs:choice>
    <xs:attribute name="requireRecognizedTypes" type="xs:boolean" default="false" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ContractPolicyType">
    <xs:annotation>
      <xs:documentation>
        Restricts what contract declarations owned by this layer or a descendant may contain.
        allowedTypeKinds and allowedMemberKinds are required comma-separated lists. Optional
        allowedPropertyAccessors narrows property accessors. allowMethodBodies,
        allowStaticMembers, and allowNestedTypes default to false when omitted.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="allowedTypeKinds" type="xs:string" use="required" />
    <xs:attribute name="allowedMemberKinds" type="xs:string" use="required" />
    <xs:attribute name="allowedPropertyAccessors" type="xs:string" />
    <xs:attribute name="allowMethodBodies" type="xs:boolean" default="false" />
    <xs:attribute name="allowStaticMembers" type="xs:boolean" default="false" />
    <xs:attribute name="allowNestedTypes" type="xs:boolean" default="false" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="TransitiveExposureType">
    <xs:annotation>
      <xs:documentation>
        Enables bounded breadth-first inspection of externally visible member types reachable
        through an otherwise allowed direct API type. maxDepth defaults to 3 and must be from
        1 through 10.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="maxDepth" type="xs:positiveInteger" default="3" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ApiSurfaceLayerRuleType">
    <xs:annotation>
      <xs:documentation>
        Selects a layer subtree by canonical path. allowedSites permits this entry only at
        listed API sites; blockedSites permits it at every API site except those listed.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="path" type="xs:string" use="required" />
    <xs:attribute name="allowedSites" type="xs:string" />
    <xs:attribute name="blockedSites" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="SourceLocationsType">
    <xs:annotation>
      <xs:documentation>
        Declares allowed physical source-file locations for declarations classified into the
        owning layer or its descendants. Child Source entries are OR alternatives. Attributes
        on one Source are conjunctive textual path matchers against a normalized source path.
        relativeTo selects whether matching is relative to the project directory, the physical
        configuration file, or the absolute normalized file path.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="Source" type="SourceLocationMatchType" />
    </xs:choice>
    <xs:attribute name="relativeTo" type="xs:string" default="Project">
      <xs:annotation>
        <xs:documentation>
          Case-insensitive relative base: Project, Configuration, or Absolute. Configuration
          is invalid for inline AssemblyMetadata settings because no physical configuration
          directory exists there.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="EntryPointsType">
    <xs:annotation>
      <xs:documentation>
        Restricts how external callers may enter this boundary after ordinary dependency
        gates have already allowed the dependency. EntryPoint alternatives may select either
        a descendant layer subtree through the layer attribute, or one or more matcher
        elements against the dependency type.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="EntryPoint" type="EntryPointType" />
    </xs:choice>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="EntryPointType">
    <xs:annotation>
      <xs:documentation>
        Boundary entry-point alternative. Use either layer="..." or matcher elements, not
        both. allowedSites and blockedSites scope where the entry point is valid.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Class" type="ClassMatchType" />
      <xs:element name="Namespace" type="NamespaceMatchType" />
      <xs:element name="Assembly" type="AssemblyMatchType" />
    </xs:choice>
    <xs:attribute name="layer" type="xs:string" />
    <xs:attribute name="allowedSites" type="xs:string" />
    <xs:attribute name="blockedSites" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="SourceLocationMatchType">
    <xs:annotation>
      <xs:documentation>
        Matches a normalized source path using one or more conjunctive textual matcher
        attributes: typeName, exactName, startsWith, endsWith, contains, or regex. Optional
        assemblyName further constrains the rule to a specific Compilation.AssemblyName.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="typeName" type="xs:string" />
    <xs:attribute name="exactName" type="xs:string" />
    <xs:attribute name="startsWith" type="xs:string" />
    <xs:attribute name="endsWith" type="xs:string" />
    <xs:attribute name="contains" type="xs:string" />
    <xs:attribute name="regex" type="xs:string" />
    <xs:attribute name="assemblyName" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!--  <Forbidden>                                                       -->
  <!--      <Class endsWith="Store" comment="Use a Repository instead."> -->
  <!--          <Fix Rename="Repository" />                               -->
  <!--      </Class>                                                      -->
  <!--      <Namespace contains="Legacy" comment="Migrate away." />      -->
  <!--  </Forbidden>                                                      -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->

  <xs:complexType name="ForbiddenContainerType">
    <xs:annotation>
      <xs:documentation>
        Groups one or more explicitly forbidden type patterns. At the root the policy applies
        globally. Inside a Layer it applies only to dependencies classified into that layer or
        one of its descendants. Depending on a matching type raises ARCH003.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Class"     type="ForbiddenClassType" />
      <xs:element name="Namespace" type="ForbiddenNamespaceType" />
    </xs:choice>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!--  <NameRules>                                                       -->
  <!--      <RequireMatchingNames allowedSites="Method, Local">          -->
  <!--          <Name endsWith="Id" />                                    -->
  <!--          <Allow from="legacyCustomerId" to="customerId" />         -->
  <!--      </RequireMatchingNames>                                       -->
  <!--  </NameRules>                                                      -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->

  <xs:complexType name="NameRulesType">
    <xs:annotation>
      <xs:documentation>
        Layer-scoped value-name policies. NameRules apply to callers classified into the
        layer that contains this element and to callers in descendant layers. They do not
        create dependency edges; they check whether named values are passed or assigned into
        differently named targets at supported dependency sites.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="RequireMatchingNames" type="RequireMatchingNamesType" />
      <xs:element name="RequireDeclarationNameMatchesType" type="RequireDeclarationNameMatchesTypeType" />
    </xs:choice>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="RequireMatchingNamesType">
    <xs:annotation>
      <xs:documentation>
        Requires the normalized source and target names to match when the configured name
        matchers apply. Name, Source, and Target use the same matcher attributes as Class.
        allowedSites and blockedSites scope where this requirement is enforced.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Name"   type="NameMatchType" />
      <xs:element name="Source" type="NameMatchType" />
      <xs:element name="Target" type="NameMatchType" />
      <xs:element name="Allow"  type="NameRuleAllowType" />
    </xs:choice>
    <xs:attribute name="allowedSites" type="xs:string" />
    <xs:attribute name="blockedSites" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="RequireDeclarationNameMatchesTypeType">
    <xs:annotation>
      <xs:documentation>
        Requires a declaration identifier to match its semantic type name after NameRules
        normalization. Type selects declared semantic types and Name selects declaration
        identifiers. Supported declaration sites are Constructor, Method, MethodReturn,
        Field, Property, and Local.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Type" type="NameMatchType" />
      <xs:element name="Name" type="NameMatchType" />
      <xs:element name="Allow" type="DeclarationNameRuleAllowType" />
    </xs:choice>
    <xs:attribute name="allowedSites" type="xs:string" />
    <xs:attribute name="blockedSites" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="DeclarationNameRuleAllowType">
    <xs:annotation>
      <xs:documentation>
        Permits one intentional type-to-declaration-name translation. Use from/to for exact
        matching, or Type and Name child elements for the full matcher attribute set.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Type" type="NameMatchType" />
      <xs:element name="Name" type="NameMatchType" />
    </xs:choice>
    <xs:attribute name="from" type="xs:string" />
    <xs:attribute name="to" type="xs:string" />
    <xs:attribute name="allowedSites" type="xs:string" />
    <xs:attribute name="blockedSites" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="NameRuleAllowType">
    <xs:annotation>
      <xs:documentation>
        Permits one intentional source-to-target name translation for the containing
        RequireMatchingNames rule. Use from/to for exact-name convenience, or Source and
        Target child elements for the full matcher attribute set. allowedSites and
        blockedSites scope where the mapping is valid.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Source" type="NameMatchType" />
      <xs:element name="Target" type="NameMatchType" />
    </xs:choice>
    <xs:attribute name="from" type="xs:string" />
    <xs:attribute name="to" type="xs:string" />
    <xs:attribute name="allowedSites" type="xs:string" />
    <xs:attribute name="blockedSites" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="NameMatchType">
    <xs:annotation>
      <xs:documentation>
        Matches a value-name subject by one or more conjunctive matcher attributes. The
        subject string is the best semantic name for a source or target, such as customerId,
        fruitId, or Customer.Id. Semantic matcher attributes such as typeKind evaluate the
        value type when Roslyn can resolve it.
      </xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="MatchAttributes" />
    <xs:attribute name="typeName" type="xs:string">
      <xs:annotation>
        <xs:documentation>Exact value-name match. Synonym of exactName for NameRules.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="typeKind" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Optional case-insensitive value-type constraint. Supported values: Class,
          Interface, Struct, Record, RecordStruct, Enum, Delegate.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ── Shared match attributes ───────────────────────────────────────── -->

  <xs:attributeGroup name="MatchAttributes">
    <xs:annotation>
      <xs:documentation>
        Pattern matching attributes. One or more may be specified per element. Every
        configured attribute on one element must match; separate elements are alternatives.
        Evaluation order (highest precedence first):
          typeName, exactName, exactFullName, inherits, implements, withAttribute,
          withAccessModifier, typeKind, endsWith, startsWith, contains, regex.

        Note: exactFullName, inherits, implements, withAttribute, withAccessModifier and
        typeKind apply to &lt;Class&gt; elements and to NameRules value-name matchers when a
        semantic value type is available.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="endsWith" type="xs:string">
      <xs:annotation>
        <xs:documentation>Matches when the subject string ends with this value.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="startsWith" type="xs:string">
      <xs:annotation>
        <xs:documentation>Matches when the subject string starts with this value.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="contains" type="xs:string">
      <xs:annotation>
        <xs:documentation>Matches when the subject string contains this value.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="regex" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Matches when the subject string matches this .NET regular expression
          (Regex.IsMatch semantics: matches anywhere in the input unless anchored
          with ^ / $). The subject is the simple type name on &lt;Class&gt; and the
          full namespace string on &lt;Namespace&gt;. Invalid patterns are ignored.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="exactName" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Exact match against the simple type name (on &lt;Class&gt;) or the full
          namespace string (on &lt;Namespace&gt;). Synonym of typeName on &lt;Class&gt;.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="exactFullName" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Exact match against the fully-qualified type name (Namespace.TypeName).
          &lt;Class&gt; only.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="inherits" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Matches types whose base-type chain contains a type with this simple or full
          name (e.g. inherits="ControllerBase"). &lt;Class&gt; only.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="implements" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Matches types that implement an interface with this simple or full name
          (transitively). &lt;Class&gt; only.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="withAttribute" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Matches types decorated with the given attribute. The 'Attribute' suffix is
          optional (withAttribute="ApiController" and "ApiControllerAttribute" both work).
          &lt;Class&gt; only.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="withAccessModifier" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Matches types declared with the given modifier(s). Supported tokens (case-
          insensitive): public, internal, private, protected, sealed, abstract, static,
          record. Multiple space-separated tokens require all to match
          (e.g. withAccessModifier="public sealed"). &lt;Class&gt; only.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment" type="xs:string">
      <xs:annotation>
        <xs:documentation>Optional human-readable note (shown in diagnostics and reports).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:attributeGroup>

  <xs:attributeGroup name="ExceptionMetadataAttributes">
    <xs:attribute name="reason" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Optional human-readable reason for the exception. May be required by ExceptionPolicy.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="owner" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Optional owner responsible for removing the exception. May be required by ExceptionPolicy.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="expiresOn" type="xs:date">
      <xs:annotation>
        <xs:documentation>
          Optional UTC calendar date in yyyy-MM-dd format after which the exception expires.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- ── Class matching ────────────────────────────────────────────────── -->

  <xs:complexType name="ClassMatchType">
    <xs:annotation>
      <xs:documentation>
        Matches types by one or more conjunctive name, fully-qualified name, base type,
        implemented interface, decorating attribute, declaration modifier, or declared-kind
        conditions. See MatchAttributes for the full list.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Exceptions" type="ExceptionsType" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attributeGroup ref="MatchAttributes" />
    <xs:attribute name="typeName" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Exact type name match (e.g. typeName="IIdentityContext"). Takes precedence over
          all pattern attributes.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="typeKind" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Optional case-insensitive declared-type constraint. Supported values: Class,
          Interface, Struct, Record, RecordStruct, Enum, Delegate. Class and Struct exclude
          records. May be used alone or combined with other matcher attributes.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="ForbiddenClassType">
    <xs:annotation>
      <xs:documentation>
        A forbidden type pattern. Any type matching the rule will trigger ARCH003.
        Add a Fix child element to offer an automatic rename quick-fix in Visual Studio.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Fix" type="FixType" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            When present, the Roslyn code fix provider will offer to rename the matched type
            by replacing its endsWith suffix with the Rename value.
            Only applicable when the parent Class uses endsWith=.
            Example: &lt;Fix Rename="Repository" /&gt; renames 'OrderStore' to 'OrderRepository'.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Exceptions" type="ExceptionsType" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attributeGroup ref="MatchAttributes" />
    <xs:attribute name="typeName" type="xs:string">
      <xs:annotation>
        <xs:documentation>Exact type name match. Takes precedence over pattern attributes.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="typeKind" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Optional case-insensitive declared-type constraint. Supported values: Class,
          Interface, Struct, Record, RecordStruct, Enum, Delegate. Class and Struct exclude
          records. May be used alone or combined with other matcher attributes.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ── Namespace matching ────────────────────────────────────────────── -->

  <xs:complexType name="NamespaceMatchType">
    <xs:annotation>
      <xs:documentation>
        Matches types by their containing namespace using endsWith, startsWith, or contains.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Exceptions" type="ExceptionsType" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attributeGroup ref="MatchAttributes" />
  </xs:complexType>

  <xs:complexType name="ForbiddenNamespaceType">
    <xs:annotation>
      <xs:documentation>
        A forbidden namespace pattern. Any type whose namespace matches will trigger ARCH003.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Exceptions" type="ExceptionsType" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attributeGroup ref="MatchAttributes" />
  </xs:complexType>

  <xs:complexType name="AssemblyMatchType">
    <xs:annotation>
      <xs:documentation>
        Matches every type whose containing assembly name matches exactName, endsWith,
        startsWith, contains, or regex.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Exceptions" type="ExceptionsType" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <xs:attribute name="exactName" type="xs:string" />
    <xs:attribute name="endsWith" type="xs:string" />
    <xs:attribute name="startsWith" type="xs:string" />
    <xs:attribute name="contains" type="xs:string" />
    <xs:attribute name="regex" type="xs:string" />
    <xs:attribute name="comment" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ExceptionClassMatchType">
    <xs:complexContent>
      <xs:extension base="ClassMatchType">
        <xs:attributeGroup ref="ExceptionMetadataAttributes" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ExceptionNamespaceType">
    <xs:complexContent>
      <xs:extension base="NamespaceMatchType">
        <xs:attributeGroup ref="ExceptionMetadataAttributes" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ExceptionAssemblyType">
    <xs:complexContent>
      <xs:extension base="AssemblyMatchType">
        <xs:attributeGroup ref="ExceptionMetadataAttributes" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="LayerNameType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
      <xs:pattern value="[^/]+" />
    </xs:restriction>
  </xs:simpleType>

  <!-- ── Exceptions (the ratchet pattern) ──────────────────────────────── -->

  <xs:complexType name="ExceptionsType">
    <xs:annotation>
      <xs:documentation>
        Types matching any child Class or Namespace are exempt from the parent rule and
        evaluation falls through to the next rule in document order. Exceptions can be
        nested: each deeper matching exception level excepts the previous level, so odd
        depths exclude and even depths include again. Exceptions support the full
        MatchAttributes set, including the semantic matchers (inherits, implements,
        withAttribute, withAccessModifier), combinable conditions, and Class typeKind.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Class"     type="ExceptionClassMatchType" />
      <xs:element name="Namespace" type="ExceptionNamespaceType" />
      <xs:element name="Assembly"  type="ExceptionAssemblyType" />
    </xs:choice>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <!-- ═══════════════════════════════════════════════════════════════════════════ -->
  <!--  <AllowedDependency from="Application" to="DataAbstraction" />            -->
  <!--  <AllowedDependency from="*"           to="Crosscutting"    />            -->
  <!-- ═══════════════════════════════════════════════════════════════════════════ -->

  <xs:complexType name="AllowedDependencyType">
    <xs:annotation>
      <xs:documentation>
        Declares a permitted directed dependency edge in the architecture graph.

        Use from="*" to allow any layer to depend on the target layer (crosscutting concern).
        Use to="*" to allow the source layer to depend on any configured layer.
        Inside a nested Layer, unqualified names resolve to direct children. Prefix a canonical
        path with "/" to address a layer from the root, such as /Ordering/Application.
        Cross-boundary dependencies must pass the root relationship and every nested egress
        and ingress gate. Set appliesToDescendants="true" when this edge should also satisfy
        descendant boundary gates, for example a framework or crosscutting layer that every
        nested boundary may use.

        Optional allowedSites and blockedSites attributes scope the edge to syntactic dependency
        sites. Supported comma-separated values: Constructor, Method, MethodReturn, Field,
        Property, Local, New, GenericInvocation, GenericArgument, Inheritance,
        InterfaceImplementation, Attribute, StaticMember. The attributes are mutually
        exclusive; if both are present or an unknown value is used, the analyzer ignores the edge.

        Only listed edges are allowed; omitting an edge makes the dependency illegal (ARCH001).
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="from" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          Local child name, root-qualified layer path, or "*" to match any layer.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="to" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Local child name, root-qualified layer path, or "*".</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="allowedSites" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Comma-separated site list. When present, this edge allows only those dependency sites.
          Supported values: Constructor, Method, MethodReturn, Field, Property, Local, New,
          GenericInvocation, GenericArgument, Inheritance, InterfaceImplementation, Attribute,
          StaticMember.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="blockedSites" type="xs:string">
      <xs:annotation>
        <xs:documentation>
          Comma-separated site list. When present, this edge allows every dependency site except
          the listed sites. Do not combine with allowedSites.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="appliesToDescendants" type="xs:boolean">
      <xs:annotation>
        <xs:documentation>
          When true, this edge can satisfy descendant boundary gates in nested layer hierarchies.
          Defaults to false so nested boundaries remain strict unless the edge opts in.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="BlockedDependencyType">
    <xs:annotation>
      <xs:documentation>
        Declares a dependency edge that is denied even when a broader AllowedDependency
        wildcard would otherwise allow it. Optional site filters scope where the block applies.
        Set appliesToDescendants="true" when the denial should also apply at descendant
        boundary gates. A cascaded block cannot be overridden by a local allowed edge.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="from" type="xs:string" use="required" />
    <xs:attribute name="to" type="xs:string" use="required" />
    <xs:attribute name="allowedSites" type="xs:string" />
    <xs:attribute name="blockedSites" type="xs:string" />
    <xs:attribute name="appliesToDescendants" type="xs:boolean" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ProjectArchitectureType">
    <xs:annotation>
      <xs:documentation>
        Declares flat project-topology groups and allowed or blocked project-reference edges.
        This is separate from type layers and is intended for project-level architecture rules.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="ProjectGroup" type="ProjectGroupType" />
      <xs:element name="AllowedProjectReference" type="ProjectReferenceRuleType" />
      <xs:element name="BlockedProjectReference" type="ProjectReferenceRuleType" />
      <xs:element name="PackagePolicy" type="PackagePolicyType" />
    </xs:choice>
    <xs:attribute name="requireRecognizedProjects" type="xs:boolean" default="false" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ProjectGroupType">
    <xs:annotation>
      <xs:documentation>
        Defines a named project group. Child Project matchers use only textual name matching
        against the project file name without the .csproj extension.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="Project" type="ProjectMatchType" />
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ProjectMatchType">
    <xs:annotation>
      <xs:documentation>
        Matches a project by one or more conjunctive textual matcher attributes:
        typeName, exactName, startsWith, endsWith, contains, or regex.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="typeName" type="xs:string" />
    <xs:attribute name="exactName" type="xs:string" />
    <xs:attribute name="startsWith" type="xs:string" />
    <xs:attribute name="endsWith" type="xs:string" />
    <xs:attribute name="contains" type="xs:string" />
    <xs:attribute name="regex" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="ProjectReferenceRuleType">
    <xs:annotation>
      <xs:documentation>
        Declares an allowed or blocked project-reference edge between project groups. Use *
        as from or to to match any configured project group.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="from" type="xs:string" use="required" />
    <xs:attribute name="to" type="xs:string" use="required" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="PackagePolicyType">
    <xs:annotation>
      <xs:documentation>
        Declares package allowlist and blocklist rules for one ProjectGroup. Allowed and
        Forbidden child containers use Package matchers against the NuGet package ID. Set
        includeTransitive="true" to evaluate transitive resolved packages as well as direct
        PackageReference entries.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="Allowed" type="PackageAllowedContainerType" />
      <xs:element name="Forbidden" type="PackageForbiddenContainerType" />
    </xs:choice>
    <xs:attribute name="projectGroup" type="xs:string" use="required" />
    <xs:attribute name="includeTransitive" type="xs:boolean" default="false" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="PackageAllowedContainerType">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="Package" type="PackageMatchType" />
    </xs:choice>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="PackageForbiddenContainerType">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:element name="Package" type="PackageMatchType" />
    </xs:choice>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="PackageMatchType">
    <xs:annotation>
      <xs:documentation>
        Matches a NuGet package ID using one or more conjunctive textual matcher attributes:
        typeName, exactName, startsWith, endsWith, contains, or regex. Matching is
        case-insensitive.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="typeName" type="xs:string" />
    <xs:attribute name="exactName" type="xs:string" />
    <xs:attribute name="startsWith" type="xs:string" />
    <xs:attribute name="endsWith" type="xs:string" />
    <xs:attribute name="contains" type="xs:string" />
    <xs:attribute name="regex" type="xs:string" />
    <xs:attribute name="comment" type="xs:string" />
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

  <xs:complexType name="FixType">
    <xs:attribute name="Rename" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>
          The replacement suffix for the rename quick-fix.
          For example, Rename="Repository" will rename 'OrderStore' to 'OrderRepository'.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="DocumentationAttributes" />
  </xs:complexType>

</xs:schema>
