<Project Sdk="Microsoft.NET.Sdk">


    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <EnableArchitecturalLevelAnalyzer>false</EnableArchitecturalLevelAnalyzer>
        <!-- Descriptor ownership lives here now, but release tracking still belongs to the
             analyzer package entrypoint project rather than this shared helper assembly. -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RonSijm.AnaalIJzer.Core.Configuration.Document\RonSijm.AnaalIJzer.Core.Configuration.Document.csproj" />
        <ProjectReference Include="..\RonSijm.AnaalIJzer.Core.Exceptions\RonSijm.AnaalIJzer.Core.Exceptions.csproj" />
        <ProjectReference Include="..\RonSijm.AnaalIJzer.Core.Findings\RonSijm.AnaalIJzer.Core.Findings.csproj" />
        <ProjectReference Include="..\RonSijm.AnaalIJzer.Core.Indicators\RonSijm.AnaalIJzer.Core.Indicators.csproj" />
    </ItemGroup>

    <ItemGroup>
    <InternalsVisibleTo Include="RonSijm.AnaalIJzer.Engine" />
        <InternalsVisibleTo Include="RonSijm.AnaalIJzer" />
        <InternalsVisibleTo Include="RonSijm.AnaalIJzer.Analyzer.Tests" />
        <InternalsVisibleTo Include="RonSijm.AnaalIJzer.Outputs" />
        <InternalsVisibleTo Include="RonSijm.AnaalIJzer.Outputs.Tests" />
        <InternalsVisibleTo Include="RonSijm.AnaalIJzer.Workspace" />
        <InternalsVisibleTo Include="RonSijm.AnaalIJzer.VisualStudio" />
        <InternalsVisibleTo Include="RonSijm.AnaalIJzer.VisualStudio.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    </ItemGroup>

</Project>
