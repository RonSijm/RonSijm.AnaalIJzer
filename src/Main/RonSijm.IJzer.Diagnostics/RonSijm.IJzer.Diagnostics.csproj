<Project Sdk="Microsoft.NET.Sdk">


    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Descriptor ownership lives here now, but release tracking still belongs to the
             analyzer package entrypoint project rather than this shared helper assembly. -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RonSijm.IJzer.Core.Configuration.Document\RonSijm.IJzer.Core.Configuration.Document.csproj" />
        <ProjectReference Include="..\RonSijm.IJzer.Core.Exceptions\RonSijm.IJzer.Core.Exceptions.csproj" />
        <ProjectReference Include="..\RonSijm.IJzer.Core.Findings\RonSijm.IJzer.Core.Findings.csproj" />
        <ProjectReference Include="..\RonSijm.IJzer.Core.Indicators\RonSijm.IJzer.Core.Indicators.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RonSijm.IJzer.CodeFixes" />
        <InternalsVisibleTo Include="RonSijm.IJzer.Engine" />
        <InternalsVisibleTo Include="RonSijm.IJzer" />
        <InternalsVisibleTo Include="RonSijm.IJzer.Analyzer.Tests" />
        <InternalsVisibleTo Include="RonSijm.IJzer.Outputs" />
        <InternalsVisibleTo Include="RonSijm.IJzer.Outputs.Tests" />
        <InternalsVisibleTo Include="RonSijm.IJzer.Workspace" />
        <InternalsVisibleTo Include="RonSijm.IJzer.VisualStudio" />
        <InternalsVisibleTo Include="RonSijm.IJzer.VisualStudio.Tests" />
    </ItemGroup>

</Project>
