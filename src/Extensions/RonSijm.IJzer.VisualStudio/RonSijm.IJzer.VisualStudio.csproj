<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../build/Settings/NuGetVersioning.props" />
    <Import Project="../../../build/Settings/Net472ReferenceAssemblies.props" />

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <RootNamespace>RonSijm.IJzer.VisualStudio</RootNamespace>
        <AssemblyName>RonSijm.IJzer.VisualStudio</AssemblyName>
        <PackageId>RonSijm.IJzer.VisualStudio</PackageId>
        <IsPackable>false</IsPackable>
        <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
        <GeneratePkgDefFile>true</GeneratePkgDefFile>
        <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
        <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
        <IJzerVsixVersion Condition="'$(IJzerVsixVersion)' == ''">1.$([System.DateTime]::UtcNow.ToString('yy')).$([System.DateTime]::UtcNow.ToString('MMdd')).$([System.DateTime]::UtcNow.ToString('HHmmss'))</IJzerVsixVersion>
        <CreateVsixContainerDependsOn>$(CreateVsixContainerDependsOn);StampIJzerVsixManifestVersion</CreateVsixContainerDependsOn>
        <CopyVsixManifestFileDependsOn>$(CopyVsixManifestFileDependsOn);StampIJzerVsixManifestVersion</CopyVsixManifestFileDependsOn>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="System.Design" />
        <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.VisualStudio.Utilities" Version="17.14.40264" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.CodeFixes\RonSijm.IJzer.CodeFixes.csproj" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.Core.Editor\RonSijm.IJzer.Core.Editor.csproj" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.Core.Indicators\RonSijm.IJzer.Core.Indicators.csproj" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.GraphModel\RonSijm.IJzer.GraphModel.csproj"
                          SetTargetFramework="TargetFramework=net472" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.GraphEditor.Wpf\RonSijm.IJzer.GraphEditor.Wpf.csproj"
                          SetTargetFramework="TargetFramework=net472" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.Graphing.Wpf\RonSijm.IJzer.Graphing.Wpf.csproj"
                          SetTargetFramework="TargetFramework=net472" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.EditorRuntime\RonSijm.IJzer.EditorRuntime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <VSCTCompile Include="Shell\Commands.vsct">
            <ResourceName>Menus.ctmenu</ResourceName>
        </VSCTCompile>
        <Content Include="source.extension.vsixmanifest">
            <SubType>Designer</SubType>
        </Content>
        <Content Include="ReleaseNotes.txt">
            <IncludeInVSIX>true</IncludeInVSIX>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="UnifiedSettings\IJzer.registration.json">
            <IncludeInVSIX>true</IncludeInVSIX>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\..\build\Settings\icon-visual-studio.png" Link="icon-visual-studio.png">
            <IncludeInVSIX>true</IncludeInVSIX>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>RonSijm.IJzer.VisualStudio.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Embed the compiled CTO as a direct manifest resource stream so VS can load it via
         Assembly.GetManifestResourceStream("Menus.ctmenu"). The VSSDK also embeds it inside
         _EmptyResource.resources, but VS needs the top-level named stream. -->
    <Target Name="EmbedCtmenuResource" AfterTargets="MergeCtoResource" BeforeTargets="CoreCompile">
        <Message Importance="High" Text="EmbedCtmenuResource: embedding $(IntermediateOutputPath)Commands.cto as Menus.ctmenu" />
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)Commands.cto">
                <LogicalName>Menus.ctmenu</LogicalName>
                <WithCulture>false</WithCulture>
                <Type>Non-Resx</Type>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

    <Target Name="StampIJzerVsixManifestVersion"
            DependsOnTargets="DetokenizeVsixManifestFile"
            Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(IntermediateVsixManifest)')">
        <XmlPoke XmlInputPath="$(IntermediateVsixManifest)"
                 Query="/*[local-name()='PackageManifest']/*[local-name()='Metadata']/*[local-name()='Identity']/@Version"
                 Value="$(IJzerVsixVersion)" />
        <Message Importance="High" Text="IJzer VSIX version = $(IJzerVsixVersion)" />
    </Target>

</Project>
