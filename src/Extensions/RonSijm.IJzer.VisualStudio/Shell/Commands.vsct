  <Commands package="guidIJzerVisualStudioPackage">
    <Menus>
      <Menu guid="guidIJzerCommandSet" id="IJzerExtensionsMenu" priority="0x0600" type="Menu">
        <Parent guid="guidIJzerCommandSet" id="IJzerExtensionsMenuPlacementGroup" />
        <Strings>
          <ButtonText>IJzer</ButtonText>
          <CommandName>IJzer</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidIJzerCommandSet" id="IJzerExtensionsMenuPlacementGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_EXTENSIONS" />
