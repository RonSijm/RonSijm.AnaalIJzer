    <Buttons>
      <Button guid="guidIJzerCommandSet" id="ShowDependencyGraphsCommand" priority="0x0100" type="Button">
        <Parent guid="guidIJzerCommandSet" id="IJzerExtensionsCommandGroup" />
        <Strings>
          <ButtonText>Show Dependency Graphs</ButtonText>
          <CommandName>IJzer.ShowDependencyGraphs</CommandName>
          <ToolTipText>Show the IJzer dependency graph tool window.</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidIJzerCommandSet" id="ShowStatusCommand" priority="0x0101" type="Button">
        <Parent guid="guidIJzerCommandSet" id="IJzerExtensionsCommandGroup" />
        <Strings>
          <ButtonText>Show Status</ButtonText>
          <CommandName>IJzer.ShowStatus</CommandName>
          <ToolTipText>Show what the IJzer extension sees for the active editor document.</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidIJzerCommandSet" id="ToggleSitesDiagnosticsCommand" priority="0x0102" type="Button">
        <Parent guid="guidIJzerCommandSet" id="IJzerExtensionsCommandGroup" />
        <Strings>
          <ButtonText>Toggle Sites Diagnostics</ButtonText>
          <CommandName>IJzer.ToggleSitesDiagnostics</CommandName>
          <ToolTipText>Toggle inline architectural dependency site labels.</ToolTipText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

