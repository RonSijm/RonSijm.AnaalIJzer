<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../../build/Settings/NuGetVersioning.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>anaaltomy</ToolCommandName>
    <PackageId>RonSijm.Anaaltomy</PackageId>
    <Description>Compiled C# structure statistics and Git-history trends for .NET projects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-anaaltomy.png</PackageIcon>
    <PackageTags>csharp;roslyn;statistics;sqlite;git;architecture</PackageTags>
    <PackageProjectUrl>https://github.com/RonSijm/RonSijm.AnaalIJzer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RonSijm/RonSijm.AnaalIJzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <EnableArchitecturalLevelAnalyzer>false</EnableArchitecturalLevelAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Main\RonSijm.Anaaltomy.Charting\RonSijm.Anaaltomy.Charting.csproj" />
    <ProjectReference Include="..\..\Main\RonSijm.AnaalIJzer.Core.Statistics\RonSijm.AnaalIJzer.Core.Statistics.csproj" />
    <ProjectReference Include="..\..\Main\RonSijm.AnaalIJzer.Statistics.GitHistory\RonSijm.AnaalIJzer.Statistics.GitHistory.csproj" />
    <ProjectReference Include="..\..\Main\RonSijm.AnaalIJzer.Statistics.Persistence.Sqlite\RonSijm.AnaalIJzer.Statistics.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\Main\RonSijm.AnaalIJzer.Statistics.Workspace\RonSijm.AnaalIJzer.Statistics.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\build\Settings\icon-anaaltomy.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RonSijm.Anaaltomy.Tests" />
  </ItemGroup>

</Project>
