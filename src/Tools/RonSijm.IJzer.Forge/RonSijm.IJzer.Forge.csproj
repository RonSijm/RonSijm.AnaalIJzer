<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../../build/Settings/NuGetVersioning.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ijzer</ToolCommandName>
    <!-- Local verification artifacts sometimes live under this project in build/Artifacts;
         exclude that tree from default Razor content discovery so the tool package stays clean. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build\**\*</DefaultItemExcludes>
    <PackageId>RonSijm.IJzer.Forge</PackageId>
    <Title>IJzer Forge</Title>
    <Description>Interactive and headless architecture tooling for IJzer: generate configurations, inspect projects, apply fixes, and produce reports.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-forge.png</PackageIcon>
    <PackageTags>architecture;analyzer;cli;tui;razorconsole;documentation;mermaid</PackageTags>
    <PackageProjectUrl>https://github.com/RonSijm/RonSijm.IJzer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RonSijm/RonSijm.IJzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="RazorConsole.Core" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Main\RonSijm.IJzer.Application\RonSijm.IJzer.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RonSijm.IJzer.Forge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\build\Settings\icon-forge.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
