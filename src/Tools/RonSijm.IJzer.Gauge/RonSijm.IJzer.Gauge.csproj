<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../../build/Settings/NuGetVersioning.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ijzer-gauge</ToolCommandName>
    <PackageId>RonSijm.IJzer.Gauge</PackageId>
    <Title>IJzer Gauge</Title>
    <Description>Compiled C# structure statistics and Git-history trends for .NET projects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-gauge.png</PackageIcon>
    <PackageTags>csharp;roslyn;statistics;sqlite;git;architecture</PackageTags>
    <PackageProjectUrl>https://github.com/RonSijm/RonSijm.IJzer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RonSijm/RonSijm.IJzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RonSijm.EF.Csv" Version="0.1.0" />
    <PackageReference Include="RonSijm.EF.Json" Version="0.1.0" />
    <PackageReference Include="RonSijm.EF.Markdown" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Main\RonSijm.IJzer.Gauge.Charting\RonSijm.IJzer.Gauge.Charting.csproj" />
    <ProjectReference Include="..\..\Main\RonSijm.IJzer.Core.Statistics\RonSijm.IJzer.Core.Statistics.csproj" />
    <ProjectReference Include="..\..\Main\RonSijm.IJzer.Statistics.GitHistory\RonSijm.IJzer.Statistics.GitHistory.csproj" />
    <ProjectReference Include="..\..\Main\RonSijm.IJzer.Statistics.Persistence.Sqlite\RonSijm.IJzer.Statistics.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\Main\RonSijm.IJzer.Statistics.Workspace\RonSijm.IJzer.Statistics.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\build\Settings\icon-gauge.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RonSijm.IJzer.Gauge.Tests" />
  </ItemGroup>

</Project>
