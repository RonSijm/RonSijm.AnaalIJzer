<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../../build/Settings/NuGetVersioning.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>arse</ToolCommandName>
    <!-- Local verification artifacts sometimes live under this project in build/Artifacts;
         exclude that tree from default Razor content discovery so the tool package stays clean. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build\**\*</DefaultItemExcludes>
    <PackageId>RonSijm.AnaalIJzer.Arse</PackageId>
    <Description>Architecture Rules, Settings, and Evidence. Interactive and headless architecture tooling for RonSijm.AnaalIJzer.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-arse.png</PackageIcon>
    <PackageTags>architecture;analyzer;cli;tui;razorconsole;documentation;mermaid</PackageTags>
    <PackageProjectUrl>https://github.com/RonSijm/RonSijm.AnaalIJzer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RonSijm/RonSijm.AnaalIJzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <EnableArchitecturalLevelAnalyzer>false</EnableArchitecturalLevelAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="RazorConsole.Core" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Main\RonSijm.AnaalIJzer.Application\RonSijm.AnaalIJzer.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RonSijm.AnaalIJzer.Arse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\build\Settings\icon-arse.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
