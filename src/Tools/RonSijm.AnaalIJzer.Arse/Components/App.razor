@namespace RonSijm.AnaalIJzer.Arse.Components

<Rows>
	<Markup Content="Arse" Foreground="@Color.DeepSkyBlue1" Decoration="@Decoration.Bold" />
	<Markup Content="Architecture Rule Standalone Executable" Foreground="@Color.Grey58" />
	<Newline />

	@if (CurrentOperation is not { } operation || CurrentInput is not { } input)
	{
		<Select TItem="string"
		        Options="@OperationOptions"
		        Value="@_selectedOperation"
		        ValueChanged="OnOperationChanged"
		        Expand="true"></Select>

		@if (IsFileAssociationOperation)
		{
			<Newline />
			<Panel Title="@_selectedOperation" Border="@BoxBorder.Rounded" BorderColor="@Color.DeepSkyBlue1" Expand="true">
				<Markup Content="This updates the current Windows user's .anl file association for Arse." Foreground="@Color.Grey70" />
			</Panel>
			<Newline />
			<Columns>
				<ArseButton Content="Run"
				              OnClick="RunFileAssociationAsync"
				              FocusOrder="0"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.DeepSkyBlue1" />
				<ArseButton Content="Back"
				              OnClick="Clear"
				              FocusOrder="1"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.Grey50" />
			</Columns>
		}

		@if (!string.IsNullOrWhiteSpace(_status))
		{
			<Newline />
			<Panel Title="@_statusTitle" Border="@BoxBorder.Rounded" BorderColor="@_statusColor" Expand="true">
				<Markup Content="@Spectre.Console.Markup.Escape(_status)" Foreground="@_statusColor" />
			</Panel>
		}
	}
	else if (operation.Kind == ApplicationOperationKind.Inspect && _inspectionReport is not null)
	{
		<Markup Content="@operation.DisplayName" Foreground="@Color.White" Decoration="@Decoration.Bold" />
		<Markup Content="@_inspectionSummary" Foreground="@_inspectionColor" />
		<Newline />

		@if (HasInspectionExceptionFindings)
		{
			<Panel Title="ARCH017 filters" Border="@BoxBorder.Rounded" BorderColor="@Color.DarkOrange" Expand="true">
				<Columns>
					<ArseButton Content="@GetInspectionExceptionFilterLabel("Invalid")"
					              OnClick="@(() => ToggleInspectionExceptionFilter("Invalid"))"
					              FocusOrder="0"
					              BackgroundColor="@Color.Grey23"
					              FocusedColor="@Color.DarkOrange" />
					<ArseButton Content="@GetInspectionExceptionFilterLabel("ExpiringSoon")"
					              OnClick="@(() => ToggleInspectionExceptionFilter("ExpiringSoon"))"
					              FocusOrder="0"
					              BackgroundColor="@Color.Grey23"
					              FocusedColor="@Color.DarkOrange" />
					<ArseButton Content="@GetInspectionExceptionFilterLabel("Expired")"
					              OnClick="@(() => ToggleInspectionExceptionFilter("Expired"))"
					              FocusOrder="0"
					              BackgroundColor="@Color.Grey23"
					              FocusedColor="@Color.DarkOrange" />
					<ArseButton Content="@GetInspectionExceptionFilterLabel("Stale")"
					              OnClick="@(() => ToggleInspectionExceptionFilter("Stale"))"
					              FocusOrder="0"
					              BackgroundColor="@Color.Grey23"
					              FocusedColor="@Color.DarkOrange" />
				</Columns>
				<Newline />
				@if (FilteredInspectionExceptionFindings.Length == 0)
				{
					<Markup Content="No ARCH017 findings match the current filter." Foreground="@Color.Grey70" />
				}
				else
				{
					@foreach (var finding in FilteredInspectionExceptionFindings)
					{
						<Markup Content="@Spectre.Console.Markup.Escape($"[{finding.State}] {finding.Message}")" Foreground="@Color.Yellow" />
						<Markup Content="@Spectre.Console.Markup.Escape(finding.Context)" Foreground="@Color.Grey70" />
						<Newline />
					}
				}
			</Panel>
			<Newline />
		}

		<ViewHeightScrollable LinesToRender="20" Context="scrollContext">
			<div data-focusable="true"
			     data-focus-order="0"
			     @onkeydown="@(args => OnInspectionReportKeyDown(args, scrollContext.KeyDownEventHandler))">
				<Panel Title="Architecture health" Border="@BoxBorder.Rounded" BorderColor="@_inspectionColor" Expand="true">
					<SyntaxHighlighter Language="markdown" Code="@_inspectionReport" />
				</Panel>
			</div>
		</ViewHeightScrollable>

		<Newline />
		@if (_selectingInspectionOutput)
		{
			<FileSelector Label="Output"
			              Value="@_outputPath"
			              ValueChanged="OnOutputPathChanged"
			              Placeholder="path\to\architecture-health.md"
			              FocusOrder="0"
			              FileExtensions="@MarkdownFileExtensions"
			              OnKeyUp="OnInspectionSaveKey" />

			<Columns>
				<ArseButton Content="Save"
				              OnClick="SaveInspectionAsync"
				              OnKeyUp="OnInspectionSaveKey"
				              FocusOrder="1"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.DeepSkyBlue1" />
				<ArseButton Content="Cancel"
				              OnClick="CancelInspectionSave"
				              OnKeyUp="OnInspectionSaveKey"
				              FocusOrder="2"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.Grey50" />
			</Columns>
		}
		else
		{
			<Columns>
				<ArseButton Content="Save"
				              OnClick="ShowInspectionSave"
				              OnKeyUp="OnInspectionResultKeyUp"
				              FocusOrder="1"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.DeepSkyBlue1" />
				<ArseButton Content="Run again"
				              OnClick="ReturnToInspectionForm"
				              OnKeyUp="OnInspectionResultKeyUp"
				              FocusOrder="2"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.Grey50" />
			</Columns>
		}

		@if (!string.IsNullOrWhiteSpace(_status))
		{
			<Newline />
			<Panel Title="@_statusTitle" Border="@BoxBorder.Rounded" BorderColor="@_statusColor" Expand="true">
				<Markup Content="@Spectre.Console.Markup.Escape(_status)" Foreground="@_statusColor" />
			</Panel>
		}
	}
	else if (operation.Kind == ApplicationOperationKind.Fixes && _fixReport is not null)
	{
		<Markup Content="@operation.DisplayName" Foreground="@Color.White" Decoration="@Decoration.Bold" />
		<Markup Content="@($"{_fixProposals.Length} proposal(s)")" Foreground="@(_fixProposals.Length > 0 ? Color.Yellow : Color.Green)" />
		<Newline />

		<ViewHeightScrollable LinesToRender="18" Context="scrollContext">
			<div data-focusable="true"
			     data-focus-order="0"
			     @onkeydown="@(args => OnFixReportKeyDown(args, scrollContext.KeyDownEventHandler))">
				<Panel Title="Configuration fixes" Border="@BoxBorder.Rounded" BorderColor="@(_fixProposals.Length > 0 ? Color.Yellow : Color.Green)" Expand="true">
					<SyntaxHighlighter Language="markdown" Code="@_fixReport" />
				</Panel>
			</div>
		</ViewHeightScrollable>

		@if (_fixProposals.Length > 0)
		{
			<Select TItem="string"
			        Options="@FixProposalOptions"
			        Value="@_selectedFixProposal"
			        ValueChanged="OnFixProposalChanged"
			        Expand="true"></Select>
		}

		<Newline />
		@if (_selectingFixOutput)
		{
			<FileSelector Label="Output"
			              Value="@_outputPath"
			              ValueChanged="OnOutputPathChanged"
			              Placeholder="path\to\architecture-fixes.md"
			              FocusOrder="1"
			              FileExtensions="@MarkdownFileExtensions"
			              OnKeyUp="OnFixSaveKey" />

			<Columns>
				<ArseButton Content="Save"
				              OnClick="SaveFixesAsync"
				              OnKeyUp="OnFixSaveKey"
				              FocusOrder="2"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.DeepSkyBlue1" />
				<ArseButton Content="Cancel"
				              OnClick="CancelFixSave"
				              OnKeyUp="OnFixSaveKey"
				              FocusOrder="3"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.Grey50" />
			</Columns>
		}
		else
		{
			<Columns>
				@if (_fixProposals.Length > 0)
				{
					<ArseButton Content="Apply selected"
					              OnClick="ApplySelectedFixAsync"
					              OnKeyUp="OnFixResultKeyUp"
					              FocusOrder="1"
					              BackgroundColor="@Color.Grey23"
					              FocusedColor="@Color.DeepSkyBlue1" />
				}
				<ArseButton Content="Save"
				              OnClick="ShowFixSave"
				              OnKeyUp="OnFixResultKeyUp"
				              FocusOrder="2"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.Grey50" />
				<ArseButton Content="Run again"
				              OnClick="ReturnToFixForm"
				              OnKeyUp="OnFixResultKeyUp"
				              FocusOrder="3"
				              BackgroundColor="@Color.Grey23"
				              FocusedColor="@Color.Grey50" />
			</Columns>
		}

		@if (!string.IsNullOrWhiteSpace(_status))
		{
			<Newline />
			<Panel Title="@_statusTitle" Border="@BoxBorder.Rounded" BorderColor="@_statusColor" Expand="true">
				<Markup Content="@Spectre.Console.Markup.Escape(_status)" Foreground="@_statusColor" />
			</Panel>
		}
	}
	else
	{
		<Markup Content="@operation.DisplayName" Foreground="@Color.White" Decoration="@Decoration.Bold" />
		<Newline />
		@if (operation.SupportedInputs.Count > 1)
		{
			<Select TItem="string"
			        Options="@CurrentInputOptions"
			        Value="@_selectedInput"
			        ValueChanged="OnInputChanged"
			        @onkeyup="OnFormKeyUp"
			        Expand="true"></Select>
		}

		<FileSelector Label="@(operation.SupportsMultipleInputs ? $"{input.DisplayName} files" : input.DisplayName)"
		              Value="@_inputPath"
		              ValueChanged="OnInputPathChanged"
		              Placeholder="@(operation.SupportsMultipleInputs ? "file1.anl; file2.anl" : input.Placeholder)"
		              FocusOrder="0"
		              FileExtensions="@CurrentInputFileExtensions"
		              AllowMultiple="@operation.SupportsMultipleInputs"
		              OnKeyUp="OnFormKeyUp" />

		@if (IsMsBuildInput(input.Kind))
		{
			<TextInput Label="Configuration"
			           Value="@_configuration"
			           ValueChanged="OnConfigurationChanged"
			           Placeholder="Release"
			           FocusOrder="1"
			           @onkeyup="OnFormKeyUp"
			           Expand="true" />
		}

		@if (operation.Kind == ApplicationOperationKind.GenerateConfig)
		{
			<Select TItem="string"
			        Options="@GenerationStrategyOptions"
			        Value="@_generationStrategy"
			        ValueChanged="OnGenerationStrategyChanged"
			        @onkeyup="OnFormKeyUp"
			        Expand="true"></Select>

			@if (_generationStrategy == ConventionsStrategy)
			{
				<TextInput Label="Minimum confidence"
				           Value="@_minimumConfidence"
				           ValueChanged="OnMinimumConfidenceChanged"
				           Placeholder="0.90"
				           FocusOrder="@MinimumConfidenceFocusOrder(input)"
				           @onkeyup="OnFormKeyUp"
				           Expand="true" />

				<TextInput Label="Minimum supporting callers"
				           Value="@_minimumSupport"
				           ValueChanged="OnMinimumSupportChanged"
				           Placeholder="5"
				           FocusOrder="@MinimumSupportFocusOrder(input)"
				           @onkeyup="OnFormKeyUp"
				           Expand="true" />
			}

			<Select TItem="string"
			        Options="@GeneratedDocumentationOptions"
			        Value="@_generatedDocumentation"
			        ValueChanged="OnGeneratedDocumentationChanged"
			        @onkeyup="OnFormKeyUp"
			        Expand="true"></Select>

			@if (_generatedDocumentation == GenerateDocumentation)
			{
				<Select TItem="string"
				        Options="@InputInclusionOptions"
				        Value="@_inputInclusion"
				        ValueChanged="OnInputInclusionChanged"
				        @onkeyup="OnFormKeyUp"
				        Expand="true"></Select>
			}
		}

		@if (operation.Kind == ApplicationOperationKind.Documentation)
		{
			@if (input.Kind == ApplicationInputKind.Project)
			{
				<Select TItem="string"
				        Options="@CodeEvidenceOptions"
				        Value="@_codeEvidence"
				        ValueChanged="OnCodeEvidenceChanged"
				        @onkeyup="OnFormKeyUp"
				        Expand="true"></Select>
			}

			<Select TItem="string"
			        Options="@InputInclusionOptions"
			        Value="@_inputInclusion"
			        ValueChanged="OnInputInclusionChanged"
			        @onkeyup="OnFormKeyUp"
			        Expand="true"></Select>
		}

		@if (operation.Kind is not ApplicationOperationKind.Inspect and not ApplicationOperationKind.Fixes)
		{
			<FileSelector Label="@(operation.OutputKind == ApplicationOutputKind.Directory ? "Output directory" : "Output")"
			              Value="@_outputPath"
			              ValueChanged="OnOutputPathChanged"
			              Placeholder="@(operation.OutputKind == ApplicationOutputKind.Directory ? "Use a config-local directory" : "Use configured default")"
			              FocusOrder="@OutputFocusOrder(operation, input)"
			              SelectionMode="@(operation.OutputKind == ApplicationOutputKind.Directory ? PathSelectionMode.Directory : PathSelectionMode.File)"
			              FileExtensions="@CurrentOutputFileExtensions"
			              OnKeyUp="OnFormKeyUp" />

			<Select TItem="string"
			        Options="@OverwriteOptions"
			        Value="@_overwrite"
			        ValueChanged="OnOverwriteChanged"
			        @onkeyup="OnFormKeyUp"
			        Expand="true"></Select>
		}

		<Newline />
		<Columns>
			<ArseButton Content="Run"
			              OnClick="RunAsync"
			              OnKeyUp="OnFormKeyUp"
			              FocusOrder="@RunFocusOrder(operation, input)"
			              BackgroundColor="@Color.Grey23"
			              FocusedColor="@Color.DeepSkyBlue1" />
			<ArseButton Content="Clear"
			              OnClick="Clear"
			              OnKeyUp="OnFormKeyUp"
			              FocusOrder="@ClearFocusOrder(operation, input)"
			              BackgroundColor="@Color.Grey23"
			              FocusedColor="@Color.Grey50" />
		</Columns>

		@if (_running)
		{
			<Newline />
			<Spinner Message="@($"Running {operation.DisplayName.ToLowerInvariant()}...")" Style="deepskyblue1" />
		}

		@if (!string.IsNullOrWhiteSpace(_status))
		{
			<Newline />
			<Panel Title="@_statusTitle" Border="@BoxBorder.Rounded" BorderColor="@_statusColor" Expand="true">
				<Markup Content="@Spectre.Console.Markup.Escape(_status)" Foreground="@_statusColor" />
			</Panel>
		}
	}
</Rows>
