@using System.Globalization
@inject IJSRuntime Js

<main class="viewer-shell">
	<header class="topbar">
		<div>
			<p class="eyebrow">Anaaltomy</p>
			<h1>SQLite Graph Viewer</h1>
		</div>
		<label class="file-picker">
			<span>Open database</span>
			<InputFile OnChange="LoadDatabaseAsync" accept=".db,.sqlite,.sqlite3" />
		</label>
	</header>

	@if (!string.IsNullOrWhiteSpace(ErrorMessage))
	{
		<section class="notice error">@ErrorMessage</section>
	}
	else if (!string.IsNullOrWhiteSpace(LoadingMessage))
	{
		<section class="notice">@LoadingMessage</section>
	}

	@if (Database is null)
	{
		<section class="empty-state">
			<h2>Open an Anaaltomy SQLite database</h2>
			<p>Use a database generated by <code>anaaltomy scan --database</code>, for example <code>build\Artifacts\Anaaltomy\anaalijzer.db</code>.</p>
		</section>
	}
	else
	{
		<section class="summary-strip">
			<div>
				<span>Scan</span>
				<strong>@Database.Scan.Status</strong>
			</div>
			<div>
				<span>Projects</span>
				<strong>@FormatCount(Database.ProjectCount)</strong>
			</div>
			<div>
				<span>Failures</span>
				<strong>@FormatCount(Database.FailureCount)</strong>
			</div>
			<div>
				<span>Input</span>
				<strong title="@Database.Scan.InputPath">@GetSubject(Database.Scan.InputPath)</strong>
			</div>
		</section>

		<section class="workspace">
			<aside class="controls">
				<label>
					<span>Statistic</span>
					<select value="@SelectedDimension" @onchange="ChangeDimension">
						@foreach (var dimension in Dimensions)
						{
							<option value="@dimension">@DisplayName(dimension)</option>
						}
					</select>
				</label>

				<label class="check-row">
					<input type="checkbox" checked="@UseGrouping" @onchange="ChangeGrouping" disabled="@(!GroupDimensions.Any())" />
					<span>Group</span>
				</label>

				<label>
					<span>Group by</span>
					<select value="@SelectedGroupDimension" @onchange="ChangeGroupDimension" disabled="@(!UseGrouping || !GroupDimensions.Any())">
						@foreach (var dimension in GroupDimensions)
						{
							<option value="@dimension">@DisplayName(dimension)</option>
						}
					</select>
				</label>

				<div class="metric-list">
					@foreach (var item in CurrentTotals.Take(8))
					{
						<div>
							<span>@DisplayName(item.Bucket)</span>
							<strong>@FormatCount(item.Count)</strong>
						</div>
					}
				</div>
			</aside>

			<section class="chart-panel">
				<div class="chart-header">
					<div>
						<p class="eyebrow">@DisplayName(SelectedDimension)</p>
						<h2>@ChartTitle</h2>
					</div>
					<strong>@FormatCount(CurrentTotal)</strong>
				</div>

				<div class="bar-chart">
					@foreach (var row in ChartRows)
					{
						<div class="bar-row" @key="row.Bucket">
							<div class="bar-label">
								<strong>@DisplayName(row.Bucket)</strong>
								<span>@FormatCount(row.Total)</span>
							</div>
							<div class="bar-track" title="@($"{DisplayName(row.Bucket)}: {FormatCount(row.Total)}")">
								@foreach (var segment in row.Segments)
								{
									<div class="bar-segment"
									     style="@GetSegmentStyle(segment, row.Total)"
									     title="@($"{DisplayName(row.Bucket)} / {DisplayName(segment.GroupBucket)}: {FormatCount(segment.Count)}")">
									</div>
								}
							</div>
						</div>
					}
				</div>

				@if (UseGrouping && LegendSegments.Any())
				{
					<div class="legend">
						@foreach (var segment in LegendSegments)
						{
							<span>
								<i style="@($"background:{segment.Color}")"></i>
								@DisplayName(segment.GroupBucket)
							</span>
						}
					</div>
				}
			</section>
		</section>

		@if (Database.Failures.Count > 0)
		{
			<section class="failure-panel">
				<h2>Scan Notes</h2>
				@foreach (var failure in Database.Failures)
				{
					<details>
						<summary>@failure.Stage</summary>
						<p>@failure.Message</p>
					</details>
				}
			</section>
		}
	}
</main>

@code {
	private static readonly string[] CanonicalDimensionOrder = ["TypeKind", "DependencySite", "TypeAccessibility", "MemberAccessibility", "MemberKind"];
	private static readonly string[] Palette = ["#2563eb", "#dc2626", "#16a34a", "#d97706", "#7c3aed", "#0891b2", "#be123c", "#4d7c0f", "#9333ea", "#0f766e"];
	private static readonly IReadOnlyDictionary<string, string> KnownColors = new Dictionary<string, string>(StringComparer.Ordinal)
	{
		["Public"] = "#2563eb",
		["Internal"] = "#dc2626",
		["Protected"] = "#16a34a",
		["ProtectedInternal"] = "#7c3aed",
		["PrivateProtected"] = "#0891b2",
		["Private"] = "#d97706",
		["File"] = "#be123c",
		["NotApplicable"] = "#64748b",
		["Class"] = "#2563eb",
		["Interface"] = "#16a34a",
		["Struct"] = "#d97706",
		["Record"] = "#7c3aed",
		["RecordStruct"] = "#0891b2",
		["Enum"] = "#be123c",
		["Delegate"] = "#4d7c0f"
	};

	private ViewerDatabase? Database { get; set; }
	private string SelectedDimension { get; set; } = "MemberKind";
	private string? SelectedGroupDimension { get; set; } = "MemberAccessibility";
	private bool UseGrouping { get; set; } = true;
	private string? ErrorMessage { get; set; }
	private string? LoadingMessage { get; set; }

	private IReadOnlyList<string> Dimensions
	{
		get
		{
			if (Database is null)
			{
				return [];
			}

			var result = Database.Measurements
				.Select(measurement => measurement.Dimension)
				.Distinct(StringComparer.Ordinal)
				.OrderBy(GetDimensionOrder)
				.ToArray();

			return result;
		}
	}

	private IReadOnlyList<string> GroupDimensions
	{
		get
		{
			if (Database is null)
			{
				return [];
			}

			var result = Database.GroupedMeasurements
				.Where(measurement => measurement.Dimension == SelectedDimension)
				.Select(measurement => measurement.GroupDimension)
				.Distinct(StringComparer.Ordinal)
				.OrderBy(GetDimensionOrder)
				.ToArray();

			return result;
		}
	}

	private IReadOnlyList<ViewerMeasurement> CurrentTotals
	{
		get
		{
			if (Database is null)
			{
				return [];
			}

			var result = Database.Measurements
				.Where(measurement => measurement.Dimension == SelectedDimension)
				.OrderByDescending(measurement => measurement.Count)
				.ToArray();

			return result;
		}
	}

	private long CurrentTotal => CurrentTotals.Sum(measurement => measurement.Count);

	private string ChartTitle => UseGrouping && !string.IsNullOrWhiteSpace(SelectedGroupDimension)
		? $"{DisplayName(SelectedDimension)} by {DisplayName(SelectedGroupDimension)}"
		: DisplayName(SelectedDimension);

	private IReadOnlyList<ChartRow> ChartRows
	{
		get
		{
			if (Database is null)
			{
				return [];
			}

			var totals = Database.Measurements
				.Where(measurement => measurement.Dimension == SelectedDimension)
				.ToDictionary(measurement => measurement.Bucket, measurement => measurement.Count, StringComparer.Ordinal);

			if (UseGrouping && !string.IsNullOrWhiteSpace(SelectedGroupDimension))
			{
				var groupedRows = Database.GroupedMeasurements
					.Where(measurement => measurement.Dimension == SelectedDimension && measurement.GroupDimension == SelectedGroupDimension)
					.GroupBy(measurement => measurement.Bucket, StringComparer.Ordinal)
					.Select(group => new ChartRow(
						group.Key,
						totals.GetValueOrDefault(group.Key, group.Sum(measurement => measurement.Count)),
						group
							.OrderByDescending(measurement => measurement.Count)
							.Select(measurement => new ChartSegment(measurement.GroupBucket, measurement.Count, GetColor(measurement.GroupBucket)))
							.ToArray()))
					.OrderByDescending(row => row.Total)
					.ToArray();

				if (groupedRows.Length > 0)
				{
					return groupedRows;
				}
			}

			var rows = CurrentTotals
				.Select(measurement => new ChartRow(
					measurement.Bucket,
					measurement.Count,
					[new ChartSegment(measurement.Bucket, measurement.Count, Palette[0])]))
				.ToArray();

			return rows;
		}
	}

	private IReadOnlyList<ChartSegment> LegendSegments
	{
		get
		{
			var result = ChartRows
				.SelectMany(row => row.Segments)
				.GroupBy(segment => segment.GroupBucket, StringComparer.Ordinal)
				.Select(group => group.First())
				.OrderBy(segment => segment.GroupBucket, StringComparer.Ordinal)
				.ToArray();

			return result;
		}
	}

	private async Task LoadDatabaseAsync(InputFileChangeEventArgs args)
	{
		ErrorMessage = null;
		LoadingMessage = "Reading database...";
		Database = null;

		try
		{
			var file = args.File;
			await using var stream = file.OpenReadStream(maxAllowedSize: 256L * 1024L * 1024L);
			using var memory = new MemoryStream();
			await stream.CopyToAsync(memory);

			LoadingMessage = "Loading SQLite in the browser...";
			var database = await Js.InvokeAsync<ViewerDatabase>("anaaltomySqlite.loadDatabase", memory.ToArray());

			Database = database;
			SelectedDimension = Dimensions.Contains("MemberKind", StringComparer.Ordinal)
				? "MemberKind"
				: Dimensions.FirstOrDefault() ?? "TypeKind";
			SelectedGroupDimension = GroupDimensions.FirstOrDefault();
			UseGrouping = SelectedGroupDimension is not null;
			LoadingMessage = null;
		}
		catch (Exception exception)
		{
			ErrorMessage = exception.Message;
			LoadingMessage = null;
		}
	}

	private void ChangeDimension(ChangeEventArgs args)
	{
		SelectedDimension = args.Value?.ToString() ?? SelectedDimension;
		SelectedGroupDimension = GroupDimensions.FirstOrDefault();
		UseGrouping = SelectedGroupDimension is not null;
	}

	private void ChangeGrouping(ChangeEventArgs args)
	{
		UseGrouping = args.Value is bool value && value;
		if (UseGrouping && string.IsNullOrWhiteSpace(SelectedGroupDimension))
		{
			SelectedGroupDimension = GroupDimensions.FirstOrDefault();
		}
	}

	private void ChangeGroupDimension(ChangeEventArgs args)
	{
		SelectedGroupDimension = args.Value?.ToString();
	}

	private string GetSegmentStyle(ChartSegment segment, long rowTotal)
	{
		var percent = rowTotal <= 0 ? 0 : Math.Max(1, segment.Count * 100m / rowTotal);
		var result = $"width:{percent.ToString("0.###", CultureInfo.InvariantCulture)}%;background:{segment.Color};";

		return result;
	}

	private static string GetColor(string value)
	{
		if (KnownColors.TryGetValue(value, out var color))
		{
			return color;
		}

		var hash = 0;
		foreach (var character in value)
		{
			hash = unchecked((hash * 31) + character);
		}

		var result = Palette[(hash & 0x7fffffff) % Palette.Length];

		return result;
	}

	private static int GetDimensionOrder(string dimension)
	{
		var index = Array.IndexOf(CanonicalDimensionOrder, dimension);
		var result = index >= 0 ? index : int.MaxValue;

		return result;
	}

	private static string GetSubject(string path)
	{
		var normalized = path.Replace('\\', '/').TrimEnd('/');
		var slash = normalized.LastIndexOf('/');
		var result = slash >= 0 ? normalized[(slash + 1)..] : normalized;

		return string.IsNullOrWhiteSpace(result) ? path : result;
	}

	private static string DisplayName(string value)
	{
		if (string.IsNullOrWhiteSpace(value))
		{
			return value;
		}

		var parts = new List<char>(value.Length + 8) { value[0] };
		for (var index = 1; index < value.Length; index++)
		{
			var current = value[index];
			var previous = value[index - 1];
			if (char.IsUpper(current) && (char.IsLower(previous) || char.IsDigit(previous)))
			{
				parts.Add(' ');
			}

			parts.Add(current);
		}

		var result = new string(parts.ToArray());

		return result;
	}

	private static string FormatCount(long value)
	{
		var result = value.ToString("N0", CultureInfo.CurrentCulture);

		return result;
	}

	private sealed class ViewerDatabase
	{
		public ViewerScan Scan { get; set; } = new();
		public int ProjectCount { get; set; }
		public int FailureCount { get; set; }
		public List<ViewerMeasurement> Measurements { get; set; } = [];
		public List<ViewerGroupedMeasurement> GroupedMeasurements { get; set; } = [];
		public List<ViewerFailure> Failures { get; set; } = [];
	}

	private sealed class ViewerScan
	{
		public long ScanId { get; set; }
		public string InputPath { get; set; } = "";
		public string Status { get; set; } = "";
		public string StartedAtUtc { get; set; } = "";
		public string? CompletedAtUtc { get; set; }
	}

	private sealed class ViewerMeasurement
	{
		public string Dimension { get; set; } = "";
		public string Bucket { get; set; } = "";
		public long Count { get; set; }
	}

	private sealed class ViewerGroupedMeasurement
	{
		public string Dimension { get; set; } = "";
		public string Bucket { get; set; } = "";
		public string GroupDimension { get; set; } = "";
		public string GroupBucket { get; set; } = "";
		public long Count { get; set; }
	}

	private sealed class ViewerFailure
	{
		public string Stage { get; set; } = "";
		public string Message { get; set; } = "";
	}

	private sealed record ChartRow(string Bucket, long Total, IReadOnlyList<ChartSegment> Segments);

	private sealed record ChartSegment(string GroupBucket, long Count, string Color);
}
