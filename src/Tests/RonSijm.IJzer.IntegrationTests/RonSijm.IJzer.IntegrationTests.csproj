<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../build/Settings/MSBuildWorkspacePackageReferences.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>

        <!-- Test project invokes example builds that attach the analyzer explicitly. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="coverlet.collector" Version="6.0.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.Engine\RonSijm.IJzer.Engine.csproj" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.Core.ReturnValues\RonSijm.IJzer.Core.ReturnValues.csproj" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.Workspace\RonSijm.IJzer.Workspace.csproj" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.Application\RonSijm.IJzer.Application.csproj" />
        <ProjectReference Include="..\..\Main\RonSijm.IJzer.EditorRuntime\RonSijm.IJzer.EditorRuntime.csproj" />
    </ItemGroup>

</Project>
