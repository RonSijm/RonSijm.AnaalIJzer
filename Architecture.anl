<?xml version="1.0" encoding="utf-8"?>
<ArchitecturalLevels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xsi:noNamespaceSchemaLocation="src/Main/RonSijm.IJzer/Scheme/IJzer.xsd"
                     description="Helpful solution baseline for RonSijm.IJzer. This configuration groups assemblies by responsibility instead of mirroring every individual project reference, so it stays readable and useful as an architectural example.">
  <Layer name="Tests"
         description="Test projects may probe any layer and are kept outside the production dependency flow.">
    <Assembly endsWith=".Tests" />
    <Assembly exactName="RonSijm.IJzer.IntegrationTests" />
  </Layer>

  <Layer name="Foundation"
         description="Shared architectural vocabulary, matcher logic, findings, policies, and configuration primitives.">
    <Assembly exactName="RonSijm.IJzer.Annotations" />
    <Assembly exactName="RonSijm.IJzer.IaC" />
    <Assembly startsWith="RonSijm.IJzer.Core.">
      <Exceptions>
        <Assembly exactName="RonSijm.IJzer.Core.Editor" />
      </Exceptions>
    </Assembly>
  </Layer>

  <Layer name="AnalysisPlatform"
         description="Roslyn-facing analysis, diagnostics, and report generation.">
    <Assembly exactName="RonSijm.IJzer" />
    <Assembly exactName="RonSijm.IJzer.Engine" />
    <Assembly exactName="RonSijm.IJzer.Diagnostics" />
    <Assembly exactName="RonSijm.IJzer.Outputs" />
  </Layer>

  <Layer name="ApplicationServices"
         description="Workspace loading, runtime orchestration, editor/runtime bridges, and configuration editing.">
    <Assembly exactName="RonSijm.IJzer.Application" />
    <Assembly exactName="RonSijm.IJzer.Workspace" />
    <Assembly exactName="RonSijm.IJzer.ConfigurationEditing" />
  </Layer>

  <Layer name="Graphing"
         description="Graph models, graph layout, graph workspace analysis, and graph editing surfaces.">
    <Assembly exactName="RonSijm.IJzer.Core.Editor" />
    <Assembly exactName="RonSijm.IJzer.EditorRuntime" />
    <Assembly startsWith="RonSijm.IJzer.Graph" />
  </Layer>

  <Layer name="Tooling"
         description="Human-facing hosts built on top of the analysis, application, and graphing layers.">
    <Assembly exactName="RonSijm.IJzer.Forge" />
    <Assembly exactName="RonSijm.IJzer.GraphEditor.Standalone" />
    <Assembly exactName="RonSijm.IJzer.VisualStudio" />
  </Layer>

  <AllowedDependency from="*" to="Foundation" appliesToDescendants="true"
                     description="Everything may rely on the shared architectural vocabulary and runtime/configuration primitives." />

  <AllowedDependency from="Foundation" to="Foundation"
                     description="Foundation projects may collaborate with each other." />

  <AllowedDependency from="AnalysisPlatform" to="AnalysisPlatform"
                     description="Analyzer components collaborate with each other." />
  <AllowedDependency from="AnalysisPlatform" to="Graphing"
                     description="Output services render and export graph snapshots from the graph model." />

  <AllowedDependency from="ApplicationServices" to="AnalysisPlatform"
                     description="Application services execute analysis and reporting workflows." />
  <AllowedDependency from="ApplicationServices" to="ApplicationServices"
                     description="Application services may collaborate with each other." />

  <AllowedDependency from="Graphing" to="AnalysisPlatform"
                     description="Graphing surfaces inspect analyzed architecture and diagnostics metadata." />
  <AllowedDependency from="Graphing" to="ApplicationServices"
                     description="Graphing workflows load workspaces and edit configurations through application services." />
  <AllowedDependency from="Graphing" to="Graphing"
                     description="Graphing components may collaborate with each other." />

  <AllowedDependency from="Tooling" to="AnalysisPlatform"
                     description="Host tools may trigger analysis and reporting workflows directly." />
  <AllowedDependency from="Tooling" to="ApplicationServices"
                     description="Host tools orchestrate workspace analysis and configuration editing." />
  <AllowedDependency from="Tooling" to="Graphing"
                     description="Host tools may render and edit dependency graphs." />
  <AllowedDependency from="Tooling" to="Tooling"
                     description="Tool-specific helpers may collaborate within the tooling layer." />

  <AllowedDependency from="Tests" to="*" appliesToDescendants="true"
                     description="Tests are allowed to reach across the system." />
</ArchitecturalLevels>
